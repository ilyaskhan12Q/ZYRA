{
  "name": "@ilyaskhan12q/zyra",
  "version": "0.9.4",
  "description": "Agent-native web performance investigation and optimization tool",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "zyra": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SKILL.md",
    "assets/investigation-graph.svg",
    "assets/zyra-logo.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ilyaskhan12Q/ZYRA.git"
  },
  "homepage": "https://github.com/ilyaskhan12Q/ZYRA#readme",
  "bugs": {
    "url": "https://github.com/ilyaskhan12Q/ZYRA/issues"
  },
  "keywords": [
    "performance",
    "web-vitals",
    "lighthouse",
    "investigation",
    "ai-agents",
    "core-web-vitals",
    "optimization",
    "lcp",
    "cls",
    "inp"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/src/cli/index.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/**/*.test.js",
    "test:unit": "node --test dist/tests/context/**/*.test.js dist/tests/cli/**/*.test.js dist/tests/evidence/**/*.test.js dist/tests/rules/**/*.test.js dist/tests/codebase/**/*.test.js dist/tests/correlation/**/*.test.js dist/tests/agent/**/*.test.js dist/tests/fixes/**/*.test.js dist/tests/verification/**/*.test.js dist/tests/ci/**/*.test.js",
    "test:integration": "node --test dist/tests/lighthouse/runner.integration.test.js",
    "lint": "echo 'Lint check clean'"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
